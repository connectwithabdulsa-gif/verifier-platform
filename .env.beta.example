# Copy to .env.beta.local. Never commit the local file.
HOST=127.0.0.1
PORT=8080
VERIFIER_API_KEY=vfy_beta_replace_with_32_random_characters
VERIFIER_SQLITE_PATH=work/beta.sqlite
VERIFIER_BOOTSTRAP_TENANT_ID=beta-local
VERIFIER_BOOTSTRAP_TENANT_NAME=Local Beta Operator
VERIFIER_MONTHLY_QUOTA=10000
VERIFIER_GREETING_IDENTITY=verify.your-real-domain.example
VERIFIER_ENVELOPE_SENDER=probe@your-real-domain.example
VERIFIER_SOURCE_IDENTITY=local-beta-egress
VERIFIER_WEBHOOK_SECRET=replace_with_an_independent_webhook_secret
VERIFIER_BILLING_WEBHOOK_SECRET=replace_with_an_independent_billing_secret
